# PostgreSQL (used by docker-compose)
POSTGRES_USER=volley
POSTGRES_PASSWORD=volley_secret
POSTGRES_DB=volleyhub

# Required
DATABASE_URL=postgresql://volley:volley_secret@localhost:5432/volleyhub
REDIS_URL=redis://localhost:6379

JWT_SECRET=your-secret-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=1h

REFRESH_TOKEN_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:3000
BCRYPT_ROUNDS=12
PORT=3000
NODE_ENV=development

# Firebase (optional, for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Admin panel seed (creates an invisible admin account at boot)
# The account is flagged is_admin = true and hidden from all public endpoints.
# Leave empty to skip the seed.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_USERNAME=admin

# Sentry (error tracking)
# Get your DSN from https://sentry.io → Project Settings → Client Keys (DSN)
# Leave empty to disable Sentry (e.g. in local dev).
SENTRY_DSN=

# Email (Resend - for password reset)
RESEND_API_KEY=
EMAIL_FROM=VolleyHub <noreply@volleyhub.app>
APP_URL=http://localhost:3000
